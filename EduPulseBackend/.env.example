# Application settings
SPRING_APPLICATION_NAME=EduPulseBackend

# MongoDB connection (use your own MongoDB URI)
SPRING_DATA_MONGODB_URI=mongodb+srv://username:password@cluster.example.net/database?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION_MS=86400000

# OAuth2 Google client configuration
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=your_client_secret_here
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_REDIRECT_URI={baseUrl}/oauth2/callback/google
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_SCOPE=email,profile

# OAuth2 callback URL for frontend
APP_OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/callback

# CORS settings
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Server port
SERVER_PORT=8080

# File upload settings
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=1000MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=1000MB

# OpenAI API configuration
APP_OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo